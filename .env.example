# Developer cockpit (Node 22 `dsh web`) — the browser build gets these from the
# Studio page as `crowdy.json`. Copy to .env and fill in. Never commit the copy.

CROWDY_GRAPHQL_URL=http://localhost:3000/graphql
CROWDY_APP_ID=
CROWDY_PROJECT_ID=

# App-scoped token (also the bearer for the metered model route)...
CROWDY_APP_TOKEN=
# ...or credentials to mint one (login -> mintAppToken).
CROWDY_EMAIL=
CROWDY_PASSWORD=

# Real empty directory the workspace picker accepts; default $HOME/crowdy-mount.
# CROWDY_MOUNT=
